{
  "name": "dsh-whale-random",
  "version": "0.1.0",
  "description": "Random per-load whale animation for the dsh Web chat running status (SVG sprite mask, no source patching).",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/variants.json",
    "scripts/build-css.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "whale", "animation"],
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
